# Copy to .env and fill from your Supabase project:
#   Project Settings -> API -> Project URL and anon/public key.
# The anon key is meant to ship in the client bundle; RLS is the security
# boundary, not key secrecy (see CLAUDE.md "Environment"). Never put a
# service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
